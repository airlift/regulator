<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.airlift</groupId>
        <artifactId>airbase</artifactId>
        <version>410</version>
    </parent>

    <artifactId>regulator</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>Regulator</name>
    <description>High-performance regular expression engine for UTF-8 Slice data with predictable linear-time matching</description>
    <url>https://github.com/airlift/regulator</url>

    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/airlift/regulator.git</connection>
        <developerConnection>scm:git:git@github.com:airlift/regulator.git</developerConnection>
        <tag>1.0</tag>
        <url>https://github.com/airlift/regulator</url>
    </scm>

    <properties>
        <air.compiler.fail-warnings>true</air.compiler.fail-warnings>
        <air.check.skip-pmd>true</air.check.skip-pmd>
        <air.javadoc.lint>all,-missing</air.javadoc.lint>
        <project.build.targetJdk>25</project.build.targetJdk>
        <regulator.nativeAccessJvmArgument />
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>slice</artifactId>
            <version>2.8</version>
        </dependency>

        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>joni</artifactId>
            <version>2.1.5.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                        <arg>-Xlint:all,-classfile,-incubating,-processing,-serial</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne \
                            @${air.main.basedir}/.mvn/errorprone.config \
                            -XepExcludedPaths:.*/target/generated-test-sources/test-annotations/.*</arg>
                    </compilerArgs>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${dep.errorprone.version}</version>
                        </path>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${dep.jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Preserve ported and generated test idioms while retaining Error Prone's correctness checks. -->
                            <compilerArgs combine.self="override">
                                <arg>--add-modules</arg>
                                <arg>jdk.incubator.vector</arg>
                                <arg>-Xlint:all,-classfile,-incubating,-processing,-serial</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne \
                                    @${air.main.basedir}/.mvn/errorprone.config \
                                    -XepExcludedPaths:.*/target/generated-test-sources/test-annotations/.* \
                                    -Xep:BooleanLiteral:OFF \
                                    -Xep:ExplicitArrayForVarargs:OFF \
                                    -Xep:FieldCanBeFinal:OFF \
                                    -Xep:InitializeInline:OFF \
                                    -Xep:InterruptedExceptionSwallowed:OFF \
                                    -Xep:LabelledBreakTarget:OFF \
                                    -Xep:NarrowingCompoundAssignment:OFF \
                                    -Xep:OperatorPrecedence:OFF \
                                    -Xep:PatternMatchingInstanceof:OFF \
                                    -Xep:StringConcatToTextBlock:OFF \
                                    -Xep:StringSplitter:OFF \
                                    -Xep:UnnecessaryFinal:OFF \
                                    -Xep:UnusedException:OFF \
                                    -Xep:UnusedMethod:OFF \
                                    -Xep:UnusedVariable:OFF</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <additionalOptions>${surefireEnablePreview} --add-modules jdk.incubator.vector</additionalOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-modules jdk.incubator.vector ${regulator.nativeAccessJvmArgument}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
