{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputsAndSharedArchives",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/input/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/candidates/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/jdks/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/engine-builds/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/language-plans/*"
      ]
    },
    {
      "Sid": "WriteResultsAndLeases",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/results/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/*/input/leases/*"
      ]
    },
    {
      "Sid": "ListLeases",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::regulator-benchmark-938463256137-*",
      "Condition": {"StringLike": {"s3:prefix": "*/input/leases/*"}}
    }
  ]
}
