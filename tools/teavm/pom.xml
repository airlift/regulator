<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.airlift.regulator</groupId>
    <artifactId>teavm-pattern-parsing-check</artifactId>
    <version>1</version>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <teavm.version>0.16.0</teavm.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>regulator</artifactId>
            <version>${regulator.version}</version>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-maven-plugin</artifactId>
                <version>${teavm.version}</version>
                <configuration>
                    <mainClass>probe.PatternParsingCheck</mainClass>
                    <optimizationLevel>ADVANCED</optimizationLevel>
                    <minifying>true</minifying>
                    <sourceMapsGenerated>false</sourceMapsGenerated>
                    <strict>true</strict>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-javascript</id>
                        <phase>package</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <targetType>JAVASCRIPT</targetType>
                            <targetDirectory>${project.build.directory}/javascript</targetDirectory>
                            <targetFileName>pattern-parsing.js</targetFileName>
                            <jsModuleType>COMMON_JS</jsModuleType>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-webassembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <targetType>WEBASSEMBLY_GC</targetType>
                            <targetDirectory>${project.build.directory}/webassembly</targetDirectory>
                            <targetFileName>pattern-parsing.wasm</targetFileName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-webassembly-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-webassembly-gc-runtime</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.build.directory}/webassembly</targetDirectory>
                            <runtimeFileName>wasm-runtime.mjs</runtimeFileName>
                            <modular>true</modular>
                            <minified>true</minified>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
