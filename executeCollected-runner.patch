@@ -753,6 +753,15 @@
     return 2 if manifest.get("suite") == "language-bulk" else 1 + len(OPERATIONS)
 
 
+def jmh_method(benchmark_class, operation):
+    """BC-2 check leg only (timing branch, not for merge): REGULATOR_BULK_EXECUTE_METHOD=executeCollected times the
+    bulk execute operation through BenchmarkLanguageBulk.executeCollected, which runs System.gc() before each op."""
+    override = os.environ.get("REGULATOR_BULK_EXECUTE_METHOD")
+    if override and operation == "execute" and benchmark_class.endswith("BenchmarkLanguageBulk"):
+        return override
+    return operation
+
+
 def benchmark_class(manifest):
