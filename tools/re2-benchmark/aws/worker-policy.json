{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputsAndSharedArchives",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::regulator-benchmark-938463256137-*/campaigns/*/input/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/shared/*"
      ]
    },
    {
      "Sid": "WriteResultsAndLeases",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::regulator-benchmark-938463256137-*/campaigns/*/results/*",
        "arn:aws:s3:::regulator-benchmark-938463256137-*/campaigns/*/input/leases/*"
      ]
    },
    {
      "Sid": "ListLeases",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::regulator-benchmark-938463256137-*",
      "Condition": {"StringLike": {"s3:prefix": "campaigns/*/input/leases/*"}}
    }
  ]
}
